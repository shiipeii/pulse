# ─────────────────────────────────────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────────────────────────────────────
# Public project URL + anon key (safe for the browser / dashboard reads under RLS).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service-role key — SERVER ONLY. Used by ingest + enrich (trusted writers).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─────────────────────────────────────────────────────────────────────────────
# Anthropic (enrichment: auto-tagging + theme labelling)
# ─────────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Model used for enrichment. Defaults to claude-sonnet-5 (fast + cheap for classification).
ANTHROPIC_MODEL=claude-sonnet-5

# ─────────────────────────────────────────────────────────────────────────────
# Embeddings (Anthropic has no embeddings endpoint — pluggable provider)
# provider: "openai" (default, OpenAI-compatible) | "voyage"
# The vector dimension MUST match the `feedback.embedding vector(N)` column in
# the migrations (default 1536 = OpenAI text-embedding-3-small).
# ─────────────────────────────────────────────────────────────────────────────
EMBEDDING_PROVIDER=openai
EMBEDDING_DIM=1536
# --- openai-compatible ---
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Point this at OpenAI, a self-hosted gateway, or Supabase's gte-small edge fn.
OPENAI_BASE_URL=https://api.openai.com/v1
# --- voyage (uncomment EMBEDDING_PROVIDER=voyage; set EMBEDDING_DIM to match) ---
VOYAGE_API_KEY=pa-...
VOYAGE_EMBEDDING_MODEL=voyage-3.5

# ─────────────────────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────────────────────
# ── Sign-in ──────────────────────────────────────────────────────────────────
# Signs session cookies. Any long random string. REQUIRED in production.
SESSION_SECRET=change-me-to-a-long-random-string
# Comma-separated emails that are always admins (they add everyone else on /admin/staff).
ADMIN_EMAILS=
# Optional shared "break-glass" password on the staff sign-in page (signs in as admin).
# The staff gate is on whenever ADMIN_EMAILS or DASHBOARD_PASSWORD is set.
DASHBOARD_PASSWORD=
# Email domains teachers may sign in with (FR-50).
ALLOWED_EMAIL_DOMAINS=moe.edu.sg,moe.gov.sg

# Public base URL — used by the add-channel wizard to render webhook/form artifacts.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shared secret protecting the /api/enrich worker trigger (cron / manual).
ENRICH_WORKER_SECRET=change-me
# Shared secret the Cloudflare Email Worker presents to ingest email channels
# (it can't hold a per-channel token). Treat as trusted-infra credential.
INGEST_MASTER_SECRET=change-me-too

# ─────────────────────────────────────────────────────────────────────────────
# Email-forward channel (Cloudflare Email Worker → /api/ingest)
# The worker posts here with this secret; it resolves <slug>@inbox.<domain>.
# ─────────────────────────────────────────────────────────────────────────────
INBOUND_EMAIL_DOMAIN=inbox.pulse.example.gov.sg

# ─────────────────────────────────────────────────────────────────────────────
# Scheduled jobs
# ─────────────────────────────────────────────────────────────────────────────
# Vercel Cron sends this automatically to /api/cron/daily; GitHub Actions uses it
# for /api/cron/frequent (mailbox + classification every 10 minutes).
CRON_SECRET=change-me-three

# ─────────────────────────────────────────────────────────────────────────────
# Optional: outbound email (fix / release notifications, reports) via Resend
# Without these, Pulse records who WOULD be emailed and you can copy reports.
# ─────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Pulse <pulse@your-verified-domain.sg>"
# Default recipients for weekly / monthly reports (comma-separated).
REPORT_RECIPIENTS=

# ─────────────────────────────────────────────────────────────────────────────
# Optional: Jira Cloud (one-click ticket filing). Without these, tickets are
# drafted in Pulse and you paste the key after filing by hand.
# ─────────────────────────────────────────────────────────────────────────────
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=TW
JIRA_BUG_ISSUE_TYPE=Bug
JIRA_FEATURE_ISSUE_TYPE=Story
# Draft a ticket once a verified theme reaches this many reports (or any critical bug).
TICKET_THRESHOLD=5

# ─────────────────────────────────────────────────────────────────────────────
# Optional: shared feedback mailbox (Microsoft 365 / Outlook via Microsoft Graph)
# IT registers an app with Mail.Read (application) limited to ONE mailbox.
# ─────────────────────────────────────────────────────────────────────────────
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Days to keep screenshots after a bug is fixed (NFR-12).
SCREENSHOT_RETENTION_DAYS=90
